@model IEnumerable<SistemaReservaHotel.Entities.Reserva>

<h2>Reservas del día</h2>

<form method="get">
    <input type="date" name="fecha" />
    <button type="submit">Buscar</button>
</form>

<table class="table">

    <thead>
        <tr>
            <th>Cliente</th>
            <th>Habitación</th>
            <th>Entrada</th>
            <th>Salida</th>
            <th>Noches</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var r in Model)
        {
            <tr>
                <td>@r.NombreCliente</td>
                <td>@r.HabitacionId</td>
                <td>@r.FechaEntrada.ToShortDateString()</td>
                <td>@r.FechaSalida.ToShortDateString()</td>
                <td>@r.Noches</td>
            </tr>
        }

    </tbody>

</table>