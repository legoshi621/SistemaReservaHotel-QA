@model SistemaReservaHotel.Entities.Reserva

<h2>Nueva Reserva</h2>

<form asp-action="Crear" method="post">

    <label>Nombre Cliente</label>
    <input asp-for="NombreCliente" class="form-control" />

    <label>Habitación</label>
    <input asp-for="HabitacionId" class="form-control" />

    <label>Tipo Habitación</label>
    <select name="tipoHabitacionId" class="form-control">
        @foreach (var tipo in ViewBag.TiposHabitacion)
        {
            <option value="@tipo.TipoHabitacionId">
                @tipo.Nombre
            </option>
        }
    </select>

    <label>Fecha Entrada</label>
    <input asp-for="FechaEntrada" type="date" class="form-control" />

    <label>Fecha Salida</label>
    <input asp-for="FechaSalida" type="date" class="form-control" />

    <button type="submit" class="btn btn-primary">
        Guardar
    </button>

</form>