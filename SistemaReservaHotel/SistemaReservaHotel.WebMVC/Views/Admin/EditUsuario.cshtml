@model SistemaReservaHotel.Business.DTOs.UsuarioDto
@{
    ViewData["Title"] = "Editar Usuario";
    var roles = ViewBag.Roles as IEnumerable<SistemaReservaHotel.Business.DTOs.RolDto>;
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-10">

            <div class="card shadow border-0 rounded-4">

                <div class="card-header text-dark border-0"
                     style="background: linear-gradient(90deg,#ffc107,#e0a800);">

                    <h4 class="mb-0">
                        <i class="bi bi-pencil-square me-2"></i>
                        Editar Usuario
                    </h4>

                </div>

                <div class="card-body p-4">

                    <form asp-controller="Admin"
                          asp-action="EditUsuario"
                          method="post">

                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="All"
                             class="text-danger mb-3"></div>

                        <!-- Información del Usuario -->

                        <div class="row mb-4">

                            <div class="col-12">

                                <h5 class="border-bottom pb-2 fw-semibold">

                                    <i class="bi bi-person-circle me-1"></i>
                                    Información Personal

                                </h5>

                            </div>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="NombreCompleto"
                                       class="form-label fw-semibold">

                                    Nombre Completo

                                </label>

                                <input asp-for="NombreCompleto"
                                       class="form-control form-control-lg" />

                                <span asp-validation-for="NombreCompleto"
                                      class="text-danger"></span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="Email"
                                       class="form-label fw-semibold">

                                    Email

                                </label>

                                <input asp-for="Email"
                                       class="form-control form-control-lg" />

                                <span asp-validation-for="Email"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="Telefono"
                                       class="form-label fw-semibold">

                                    Teléfono

                                </label>

                                <input asp-for="Telefono"
                                       class="form-control form-control-lg" />

                                <span asp-validation-for="Telefono"
                                      class="text-danger"></span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label class="form-label fw-semibold">
                                    Estado
                                </label>

                                <div class="form-check form-switch">

                                    <input asp-for="Activo"
                                           class="form-check-input"
                                           type="checkbox"
                                           role="switch"
                                           id="switchActivo" />

                                    <label class="form-check-label"
                                           for="switchActivo">

                                        @(Model.Activo ? "Usuario Activo" : "Usuario Inactivo")

                                    </label>

                                </div>

                            </div>

                        </div>

                        <!-- Roles Asignados -->

                        <div class="row mt-4 mb-4">

                            <div class="col-12">

                                <h5 class="border-bottom pb-2 fw-semibold">

                                    <i class="bi bi-person-badge me-1"></i>
                                    Roles Asignados

                                </h5>

                            </div>

                        </div>

                        <div class="row">

                            <div class="col-12 mb-3">

                                @if (Model.Roles != null && Model.Roles.Any())
                                {
                                    <div class="alert alert-info shadow-sm border-0">

                                        <strong>Roles actuales:</strong>

                                        <div class="mt-2">

                                            @foreach (var rol in Model.Roles)
                                            {
                                                <span class="badge bg-primary me-2 mb-1">

                                                    <i class="bi bi-shield-check me-1"></i>
                                                    @rol

                                                </span>
                                            }

                                        </div>

                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-warning border-0">

                                        <i class="bi bi-exclamation-triangle me-1"></i>
                                        Este usuario no tiene roles asignados.

                                    </div>
                                }

                            </div>

                        </div>

                        <div class="row">

                            <div class="col-12">

                                <div class="card border-0 shadow-sm rounded-3">

                                    <div class="card-header bg-light">

                                        <strong>Gestionar Roles</strong>

                                    </div>

                                    <div class="card-body">

                                        @if (roles != null && roles.Any())
                                        {
                                            <div class="row">

                                                @foreach (var rol in roles)
                                                {
                                                    var tieneRol = Model.Roles?.Contains(rol.Nombre) ?? false;

                                                    <div class="col-md-6 mb-3">

                                                        <div class="card @(tieneRol ? "border-success" : "border-light") shadow-sm rounded-3">

                                                            <div class="card-body">

                                                                <div class="d-flex justify-content-between align-items-center">

                                                                    <div>

                                                                        <h6 class="mb-1">

                                                                            @if (tieneRol)
                                                                            {
                                                                                <i class="bi bi-check-circle-fill text-success me-1"></i>
                                                                            }

                                                                            <strong>@rol.Nombre</strong>

                                                                        </h6>

                                                                        <small class="text-muted">
                                                                            @rol.Descripcion
                                                                        </small>

                                                                    </div>

                                                                    <div>

                                                                        @if (tieneRol)
                                                                        {
                                                                            <form asp-controller="Admin"
                                                                                  asp-action="RemoverRol"
                                                                                  method="post"
                                                                                  class="d-inline">

                                                                                <input type="hidden" name="usuarioId" value="@Model.Id" />
                                                                                <input type="hidden" name="rolId" value="@rol.Id" />

                                                                                <button type="submit"
                                                                                        class="btn btn-sm btn-outline-danger"
                                                                                        onclick="return confirm('¿Remover rol @rol.Nombre?');">

                                                                                    <i class="bi bi-dash-circle me-1"></i>
                                                                                    Remover

                                                                                </button>

                                                                            </form>
                                                                        }
                                                                        else
                                                                        {
                                                                            <form asp-controller="Admin"
                                                                                  asp-action="AsignarRol"
                                                                                  method="post"
                                                                                  class="d-inline">

                                                                                <input type="hidden" name="usuarioId" value="@Model.Id" />
                                                                                <input type="hidden" name="rolId" value="@rol.Id" />

                                                                                <button type="submit"
                                                                                        class="btn btn-sm btn-success">

                                                                                    <i class="bi bi-plus-circle me-1"></i>
                                                                                    Asignar

                                                                                </button>

                                                                            </form>
                                                                        }

                                                                    </div>

                                                                </div>

                                                            </div>

                                                        </div>

                                                    </div>
                                                }

                                            </div>
                                        }
                                        else
                                        {
                                            <p class="text-muted mb-0">
                                                No hay roles disponibles en el sistema.
                                            </p>
                                        }

                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- Información adicional -->

                        <div class="row mt-4">

                            <div class="col-12">

                                <div class="card border-0 bg-light shadow-sm">

                                    <div class="card-body">

                                        <div class="row">

                                            <div class="col-md-6">

                                                <small class="text-muted">

                                                    <i class="bi bi-calendar-plus me-1"></i>
                                                    <strong>Fecha de Registro:</strong>
                                                    @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")

                                                </small>

                                            </div>

                                            <div class="col-md-6">

                                                <small class="text-muted">

                                                    <i class="bi bi-clock-history me-1"></i>
                                                    <strong>Último Acceso:</strong>

                                                    @if (Model.UltimoAcceso.HasValue)
                                                    {
                                                        @Model.UltimoAcceso.Value.ToString("dd/MM/yyyy HH:mm")
                                                    }
                                                    else
                                                    {
                                                        <span>Nunca ha ingresado</span>
                                                    }

                                                </small>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <hr class="my-4" />

                        <!-- Botones -->

                        <div class="d-flex justify-content-between">

                            <a asp-controller="Admin"
                                   asp-action="Usuarios"
                                   class="btn btn-secondary">

                                <i class="bi bi-arrow-left me-1"></i>
                                Volver a la Lista

                            </a>

                            <div>

                                <button type="submit"
                                        class="btn btn-warning me-2 shadow-sm">

                                    <i class="bi bi-save me-1"></i>
                                    Guardar Cambios

                                </button>

                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        onclick="window.location.reload();">

                                    <i class="bi bi-arrow-clockwise me-1"></i>
                                    Deshacer

                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.getElementById('switchActivo').addEventListener('change', function() {
        var label = this.nextElementSibling;
        label.textContent = this.checked ? 'Usuario Activo' : 'Usuario Inactivo';
        });

    </script>

}
