@model IEnumerable<SistemaReservaHotel.Business.DTOs.RolDto>
@{
    ViewData["Title"] = "Gestión de Roles";
}

<div class="container-fluid mt-4">

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <h4 class="mb-0">
                <i class="bi bi-person-badge text-primary"></i>
                Gestión de Roles
            </h4>

            <a asp-controller="Roles" asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Nuevo Rol
            </a>
        </div>
    </div>

    <div class="row">

        @if (Model != null && Model.Any())
        {
            @foreach (var rol in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">

                    <div class="card h-100 shadow-sm border-0">

                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <strong>
                                <i class="bi bi-shield-check text-primary"></i>
                                @rol.Nombre
                            </strong>

                            @if (rol.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactivo</span>
                            }
                        </div>

                        <div class="card-body">

                            <p class="text-muted mb-3">
                                @(string.IsNullOrEmpty(rol.Descripcion) ? "Sin descripción disponible." : rol.Descripcion)
                            </p>

                            <h6 class="text-muted mb-2">
                                <i class="bi bi-key"></i> Permisos
                            </h6>

                            @if (rol.PermisosNombres != null && rol.PermisosNombres.Any())
                            {
                                <div style="max-height:160px; overflow-y:auto;">
                                    @foreach (var permiso in rol.PermisosNombres.Take(10))
                                    {
                                        <span class="badge bg-info text-dark me-1 mb-1">
                                            @permiso
                                        </span>
                                    }

                                    @if (rol.PermisosNombres.Count > 10)
                                    {
                                        <span class="badge bg-secondary">
                                            +@(rol.PermisosNombres.Count - 10) más
                                        </span>
                                    }
                                </div>

                                <small class="text-muted d-block mt-2">
                                    Total: @rol.PermisosNombres.Count permisos
                                </small>
                            }
                            else
                            {
                                <div class="alert alert-warning py-2 mb-0">
                                    <small>
                                        <i class="bi bi-exclamation-triangle"></i>
                                        Sin permisos asignados
                                    </small>
                                </div>
                            }

                        </div>

                        <div class="card-footer bg-white">

                            <div class="d-flex justify-content-between">

                                <a asp-controller="Roles"
                                       asp-action="AsignarPermisos"
                                       asp-route-id="@rol.Id"
                                       class="btn btn-sm btn-primary">
                                    <i class="bi bi-gear"></i> Permisos
                                </a>

                                <div class="btn-group btn-group-sm">

                                    <a asp-controller="Roles"
                                           asp-action="Edit"
                                           asp-route-id="@rol.Id"
                                           class="btn btn-outline-warning">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    @if (rol.Nombre != "Administrador")
                                    {
                                        <form asp-controller="Roles"
                                              asp-action="Delete"
                                              asp-route-id="@rol.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('¿Desactivar el rol @rol.Nombre?');">

                                            <button class="btn btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-secondary" disabled>
                                            <i class="bi bi-lock"></i>
                                        </button>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }
        }
        else
        {
            <div class="col-12">

                <div class="card shadow-sm border-0 text-center p-5">
                    <i class="bi bi-person-x text-muted" style="font-size:3rem;"></i>

                    <h5 class="mt-3">
                        No hay roles registrados
                    </h5>

                    <p class="text-muted">
                        Crea el primer rol para comenzar a gestionar permisos.
                    </p>

                    <a asp-controller="Roles" asp-action="Create" class="btn btn-success">
                        <i class="bi bi-plus-circle"></i>
                        Crear Primer Rol
                    </a>

                </div>

            </div>
        }

    </div>

</div>
