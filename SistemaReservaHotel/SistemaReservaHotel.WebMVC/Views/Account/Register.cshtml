@model SistemaReservaHotel.Business.DTOs.RegisterDto
@{
    ViewData["Title"] = "Registrarse";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8 col-lg-6">

        <div class="card shadow border-0 rounded-4">

            <div class="card-header text-white text-center border-0"
                 style="background: linear-gradient(90deg,#198754,#157347);">

                <h3 class="mb-0">
                    <i class="bi bi-person-plus me-2"></i> Crear Cuenta
                </h3>

            </div>

            <div class="card-body p-4">

                <form asp-controller="Account" asp-action="Register" method="post">

                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="NombreCompleto" class="form-label fw-semibold">
                            Nombre Completo
                        </label>

                        <input asp-for="NombreCompleto"
                               class="form-control form-control-lg" />

                        <span asp-validation-for="NombreCompleto"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">
                            Email
                        </label>

                        <input asp-for="Email"
                               class="form-control form-control-lg"
                               placeholder="tu@email.com" />

                        <span asp-validation-for="Email"
                              class="text-danger"></span>
                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="Password"
                                   class="form-label fw-semibold">
                                Contraseña
                            </label>

                            <input asp-for="Password"
                                   class="form-control form-control-lg" />

                            <span asp-validation-for="Password"
                                  class="text-danger"></span>

                            <small class="text-muted">
                                Mínimo 6 caracteres
                            </small>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="ConfirmPassword"
                                   class="form-label fw-semibold">
                                Confirmar Contraseña
                            </label>

                            <input asp-for="ConfirmPassword"
                                   class="form-control form-control-lg" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Telefono"
                               class="form-label fw-semibold">
                            Teléfono (opcional)
                        </label>

                        <input asp-for="Telefono"
                               class="form-control form-control-lg"
                               placeholder="7xxx-xxxx" />

                        <span asp-validation-for="Telefono"
                              class="text-danger"></span>

                    </div>

                    <div class="d-grid">

                        <button type="submit"
                                class="btn btn-success btn-lg shadow-sm">

                            <i class="bi bi-check-circle me-1"></i>
                            Registrarse

                        </button>

                    </div>

                    <hr class="my-4" />

                    <div class="text-center">

                        <p class="mb-0">
                            ¿Ya tienes cuenta?

                            <a asp-controller="Account"
                                   asp-action="Login"
                                   class="fw-bold text-decoration-none">

                                Inicia sesión aquí

                            </a>
                        </p>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
