@{
    ViewData["Title"] = "Inicio";
    var esAdmin = User.IsInRole("Administrador");
}

<div class="container-fluid mt-4">

    <!-- Bienvenida -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body p-5 text-white"
             style="background: linear-gradient(135deg,#0891B2,#059669); border-radius:12px;">

            <div class="row align-items-center">

                <div class="col-md-8">

                    <h2 class="mb-3">
                        <i class="bi bi-receipt"></i>
                        Sistema de Reserva Hotel
                    </h2>

                    <p class="lead mb-3">
                        Bienvenido
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <strong>@User.Identity.Name</strong>
                        }
                        al sistema de Reserva Hotel
                    </p>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div>

                            <span class="badge bg-light text-dark me-2">
                                <i class="bi bi-shield-check"></i>
                                Sesión Activa
                            </span>

                            @foreach (var claim in User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role))
                            {
                                <span class="badge bg-light text-dark">
                                    @claim.Value
                                </span>
                            }

                        </div>
                    }

                </div>

                <div class="col-md-4 text-center">

                    <i class="bi bi-graph-up-arrow"
                       style="font-size:7rem; opacity:.25;"></i>

                </div>

            </div>

        </div>

    </div>


    @if (User.Identity?.IsAuthenticated == true)
    {

        <!-- Accesos rápidos -->
        <div class="card shadow-sm border-0 mb-4">

            <div class="card-body">

                <h5 class="mb-4">
                    <i class="bi bi-lightning text-warning"></i>
                    Accesos Rápidos
                </h5>

                <div class="row g-4">

                    <!-- Clientes -->
                    <div class="col-md-6 col-lg-3">

                        <div class="card border-0 shadow-sm h-100 hover-card">

                            <div class="card-body text-center p-4">

                                <i class="bi bi-person-lines-fill text-primary"
                                   style="font-size:3rem;"></i>

                                <h6 class="mt-3">Clientes</h6>

                                <p class="text-muted small">
                                    Gestión de clientes
                                </p>

                                <a href="/Clientes"
                                       class="btn btn-primary btn-sm stretched-link">
                                    Abrir
                                </a>

                            </div>

                        </div>

                    </div>

                    <!-- Productos -->
                    <div class="col-md-6 col-lg-3">

                        <div class="card border-0 shadow-sm h-100 hover-card">

                            <div class="card-body text-center p-4">

                                <i class="bi bi-box-seam text-success"
                                   style="font-size:3rem;"></i>

                                <h6 class="mt-3">Productos</h6>

                                <p class="text-muted small">
                                    Catálogo e inventario
                                </p>

                                <a href="/Productos"
                                       class="btn btn-success btn-sm stretched-link">
                                    Abrir
                                </a>

                            </div>

                        </div>

                    </div>

                    <!-- Ventas -->
                    <div class="col-md-6 col-lg-3">

                        <div class="card border-0 shadow-sm h-100 hover-card">

                            <div class="card-body text-center p-4">

                                <i class="bi bi-cart-check text-warning"
                                   style="font-size:3rem;"></i>

                                <h6 class="mt-3">Ventas</h6>

                                <p class="text-muted small">
                                    Gestión de facturación
                                </p>

                                <a href="/Ventas"
                                       class="btn btn-warning btn-sm stretched-link">
                                    Abrir
                                </a>

                            </div>

                        </div>

                    </div>

                    <!-- Admin -->
                    @if (esAdmin)
                    {
                        <div class="col-md-6 col-lg-3">

                            <div class="card border-0 shadow-sm h-100 hover-card">

                                <div class="card-body text-center p-4">

                                    <i class="bi bi-shield-lock text-danger"
                                       style="font-size:3rem;"></i>

                                    <h6 class="mt-3">Administración</h6>

                                    <p class="text-muted small">
                                        Panel administrativo
                                    </p>

                                    <a asp-controller="Admin"
                                           asp-action="Index"
                                           class="btn btn-danger btn-sm stretched-link">
                                        Abrir
                                    </a>

                                </div>

                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- Resumen -->
        <div class="card shadow-sm border-0">

            <div class="card-body">

                <h5 class="mb-4">
                    <i class="bi bi-bar-chart text-primary"></i>
                    Resumen del Sistema
                </h5>

                <div class="row g-4">

                    <div class="col-md-6 col-lg-3">

                        <div class="card border-0 shadow-sm">

                            <div class="card-body d-flex align-items-center">

                                <div class="bg-primary bg-opacity-10 p-3 rounded">

                                    <i class="bi bi-people-fill text-primary"
                                       style="font-size:1.8rem;"></i>

                                </div>

                                <div class="ms-3">

                                    <small class="text-muted">
                                        Clientes
                                    </small>

                                    <h4 class="mb-0">-</h4>

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-6 col-lg-3">

                        <div class="card border-0 shadow-sm">

                            <div class="card-body d-flex align-items-center">

                                <div class="bg-success bg-opacity-10 p-3 rounded">

                                    <i class="bi bi-box-seam-fill text-success"
                                       style="font-size:1.8rem;"></i>

                                </div>

                                <div class="ms-3">

                                    <small class="text-muted">
                                        Productos
                                    </small>

                                    <h4 class="mb-0">-</h4>

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-6 col-lg-3">

                        <div class="card border-0 shadow-sm">

                            <div class="card-body d-flex align-items-center">

                                <div class="bg-warning bg-opacity-10 p-3 rounded">

                                    <i class="bi bi-receipt-cutoff text-warning"
                                       style="font-size:1.8rem;"></i>

                                </div>

                                <div class="ms-3">

                                    <small class="text-muted">
                                        Ventas Hoy
                                    </small>

                                    <h4 class="mb-0">-</h4>

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-6 col-lg-3">

                        <div class="card border-0 shadow-sm">

                            <div class="card-body d-flex align-items-center">

                                <div class="bg-info bg-opacity-10 p-3 rounded">

                                    <i class="bi bi-cash-stack text-info"
                                       style="font-size:1.8rem;"></i>

                                </div>

                                <div class="ms-3">

                                    <small class="text-muted">
                                        Total Hoy
                                    </small>

                                    <h4 class="mb-0">$-</h4>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    }
    else
    {

        <!-- Usuario no autenticado -->

        <div class="row justify-content-center">

            <div class="col-md-6">

                <div class="card shadow-lg border-0 text-center">

                    <div class="card-body p-5">

                        <i class="bi bi-lock text-muted mb-4"
                           style="font-size:4rem;"></i>

                        <h4 class="mb-3">
                            Acceso al Sistema
                        </h4>

                        <p class="text-muted mb-4">
                            Inicia sesión para utilizar el sistema de Reserva Hotel.
                        </p>

                        <div class="d-flex justify-content-center gap-3">

                            <a asp-controller="Account"
                                   asp-action="Login"
                                   class="btn btn-primary">
                                <i class="bi bi-box-arrow-in-right"></i>
                                Iniciar Sesión
                            </a>

                            <a asp-controller="Account"
                                   asp-action="Register"
                                   class="btn btn-outline-primary">
                                <i class="bi bi-person-plus"></i>
                                Registrarse
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    }

</div>


<style>

    .hover-card {
        transition: all .2s ease;
    }

        .hover-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,.12);
        }

</style>
